# --- Certificate system (see README-certificates.md) ---
# Service-account credentials for uploading stamped certs to Drive.
# Create at console.cloud.google.com → IAM → Service Accounts → generate JSON key.
# Share the destination Drive folder with this account as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=cert-uploader@your-project.iam.gserviceaccount.com
# Paste the private key from the service-account JSON. Keep the literal "\n"
# escape sequences — the app converts them back to real newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Drive folder ID (last path segment of the folder URL in Google Drive).
DRIVE_FOLDER_ID=1U4qpTsQsoe41MfbyggjCU-4pyToQqjYY

# --- Live Google rating in the TrustBar (auto-updates; optional) ---
# A Google Cloud API key with the "Places API (New)" enabled (billing on;
# restrict the key to that API). Server-side only — do NOT prefix NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
# The JustInsurance Google Business Profile place_id (starts with "ChIJ...").
# If either var is blank the TrustBar shows the last-known-good fallback (4.9/22).
GOOGLE_PLACE_ID=ChIJif0rmven2YgRDrPDfn-JP8w
